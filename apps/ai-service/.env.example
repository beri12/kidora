# ---------------------------------------------------------------------------
# Kidora AI service. Copy to .env. Never commit real keys.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM -------------------------------------------------------------------
# openai | anthropic | google | local
# `local` is the offline fallback: it returns a clearly-labelled "unavailable"
# response rather than pretending to answer, so the platform still works with
# no key configured.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

AI_MAX_TOKENS=700
AI_TEMPERATURE=0.4
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT=60

# --- Service-to-service auth ----------------------------------------------
# Shared secret proving a request came from the Kidora API rather than the open
# internet. Must match AI_SERVICE_TOKEN in kidora-api. Required in production.
AI_SERVICE_TOKEN=

# --- Infrastructure (Phase 3+) ---------------------------------------------
DATABASE_URL=
REDIS_URL=
