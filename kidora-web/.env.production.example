# Kidora web — production. Only NEXT_PUBLIC_* values exist here, and they are
# PUBLIC: they are baked into the JavaScript every visitor downloads. Never put
# a secret in this file. docker-compose.production.yml passes these as build
# args; with Vercel, set them in the project's environment settings.
NEXT_PUBLIC_API_URL=https://api.justkidora.com/api
NEXT_PUBLIC_APP_URL=https://justkidora.com
# Shown in "Contact Kidora" on /terms; leave empty until ready.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
