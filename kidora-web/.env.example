# Base URL of the Kidora API, including the /api prefix.
# This single value also backs NEXT_PUBLIC_API_BASE_URL (see src/lib/env.ts)
# and is used to derive the websocket origin for chat and live games.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public origin of this web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Checkout keys. Only required to actually start a payment; the app builds
# and runs without them.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
