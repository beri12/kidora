# ---------------------------------------------------------------------------
# Kidora Web — environment
#
# No new variables were added for the school LMS. All four below already
# existed; they are listed here because a missing one now fails the production
# build (src/lib/env.ts throws in production, by design).
# ---------------------------------------------------------------------------

# Used by src/lib/axios.ts — the canonical API client for all new code.
NEXT_PUBLIC_API_URL=https://api.justkidora.com/api

# Used by src/lib/env.ts + src/lib/http.ts (the payment flow).
NEXT_PUBLIC_API_BASE_URL=https://api.justkidora.com/api
NEXT_PUBLIC_APP_URL=https://justkidora.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Server-only. Read by src/app/middleware.ts to verify the role cookie.
JWT_SECRET=
