# Public, NON-SECRET configuration only. Everything prefixed EXPO_PUBLIC_ is
# inlined into the JavaScript bundle and can be read by anyone who has the app.
# Never put API keys, OpenAI keys, database URLs or signing secrets here —
# those stay on the Kidora backend.

# REST base URL, including the /api global prefix.
#   production:  https://api.justkidora.com/api
#   development: http://localhost:4000/api  (Android emulator: http://10.0.2.2:4000/api)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Socket.IO origin (no /api suffix).
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# development | preview | production
EXPO_PUBLIC_ENVIRONMENT=development
