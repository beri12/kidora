# ---------------------------------------------------------------------------
# Kidora API — PRODUCTION. Copy to kidora-api/.env.production on the server.
# Never commit the real file. One block only: a key defined twice silently
# takes the LAST value (the API warns about duplicates at boot).
# Generate secrets with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
PORT=4000
NODE_ENV=production
# The public addresses. Every OAuth callback and email link is built from
# these, so they must be the https URLs people actually use.
API_URL=https://api.justkidora.com/api
API_PUBLIC_BASE=https://api.justkidora.com
WEB_URL=https://justkidora.com
CORS_ORIGIN=https://justkidora.com,https://www.justkidora.com

# --- Database / Redis (service names from docker-compose.production.yml) ---
# URL-encode special characters in the password: @ -> %40, # -> %23, : -> %3A
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://kidora:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/kidora?schema=public
REDIS_URL=redis://redis:6379

# --- JWT (new random values; never reuse the development ones) ------------
JWT_ACCESS_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_openssl_rand_hex_32
OAUTH_STATE_SECRET=REPLACE_WITH_A_THIRD_openssl_rand_hex_32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
MFA_ISSUER=Kidora

# --- Pilot ----------------------------------------------------------------
# Until this date every plan starts free (prices stay visible) and all of
# Kidora is open. Remove it, or let it pass, to charge the listed prices.
PILOT_FREE_UNTIL=2026-12-31

# --- Email (verification codes) -------------------------------------------
# Gmail works for a pilot (16-letter App Password); for volume use a
# transactional provider (Brevo, Mailgun, SES, Resend SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_SENDING_ADDRESS
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
MAIL_FROM="Kidora <REPLACE_WITH_SENDING_ADDRESS>"

# --- SMS (Twilio) ---------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+251
SMS_STRICT=true

# --- Social sign-in (register each callback EXACTLY with the provider) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.justkidora.com/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://api.justkidora.com/api/auth/facebook/callback

# --- Payments -------------------------------------------------------------
# Keep sandbox until a sandbox purchase has been tested end to end.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# CHAPA_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Storage --------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
STORAGE_PUBLIC_BASE=https://api.justkidora.com/uploads
UPLOAD_MAX_BYTES=524288000

# --- AI service (internal only) -------------------------------------------
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32
# Kai (AI tutor): LLM_PROVIDER=openai and LLM_API_KEY=<your OpenAI key>.
# Passed to the ai-service container only; this API never calls OpenAI itself.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
