// ---------------------------------------------------------------------------
// Quests — the student-facing, game-shaped wrapper around real curriculum.
// A quest always points at a course (and optionally one section of it), so a
// quest can never be "random entertainment" detached from learning objectives.
// ---------------------------------------------------------------------------

model Quest {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  story      String         @default("")
  npcName    String?
  npcEmoji   String         @default("🧙")
  world      World          @default(MATH_ISLAND)
  zone       String?
  order      Int            @default(0)
  courseId   String?
  sectionId  String?
  xpReward   Int            @default(100)
  coinReward Int            @default(30)
  badgeSlug  String?
  isBoss     Boolean        @default(false)
  published  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  course     Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  students   StudentQuest[]

  @@index([world, order])
  @@index([courseId])
}

model StudentQuest {
  id          String      @id @default(cuid())
  questId     String
  studentId   String
  status      QuestStatus @default(AVAILABLE)
  progress    Int         @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime    @default(now()) @updatedAt
  quest       Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([questId, studentId])
  @@index([studentId, status])
}

// Append-only XP ledger. Every XP change made by the central reward service
// writes one row here, so XP is auditable and can never be set by a client.
model XpEvent {
  id        String   @id @default(cuid())
  studentId String
  reason    XpReason
  amount    Int
  coins     Int      @default(0)
  refType   String?
  refId     String?
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([reason])
}

// Educational telemetry. Deliberately free of personal detail beyond the
// pseudonymous user id — no device fingerprints, no ad identifiers.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  schoolId  String?
  courseId  String?
  props     Json     @default("{}")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}

// Audit trail for sensitive admin/teacher operations.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  schoolId  String?
  action    String
  entity    String
  entityId  String?
  meta      Json     @default("{}")
  ip        String   @default("")
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Monetisation scaffolding (Phase 33). Present so the architecture supports
// school subscriptions and sponsored programmes later; nothing in the child
// learning path reads these, and core learning stays free.
// ---------------------------------------------------------------------------

model SchoolSubscription {
  id         String    @id @default(cuid())
  schoolId   String
  plan       PlanKey   @default(school)
  status     String    @default("active")
  seats      Int       @default(0)
  renewsAt   DateTime?
  externalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SponsorCampaign {
  id        String    @id @default(cuid())
  name      String
  sponsor   String
  // Contextual only: which subject/grade the sponsorship funds. No behavioural
  // targeting and no per-child profiling — see PHASE 32 in KIDORA_UPDATE_PLAN.md.
  subjectId String?
  gradeId   String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

