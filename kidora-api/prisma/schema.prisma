generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String?
  name               String
  role               Role                   @default(PARENT)
  avatarColor        String                 @default("#8B5CF6")
  avatarUrl          String?
  points             Int                    @default(0)
  streak             Int                    @default(0)
  googleId           String?                @unique
  mfaEnabled         Boolean                @default(false)
  mfaSecret          String?
  backupCodes        String[]               @default([])
  failedLogins       Int                    @default(0)
  lockedUntil        DateTime?
  emailVerified      Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  schoolId           String?
  gradeId            String?
  aiConversations    AIConversation[]
  avatar             Avatar?
  certificates       Certificate[]
  children           ChildProfile[]         @relation("ParentChildren")
  coursesOwned       Course[]               @relation("TeacherCourses")
  inventory          Inventory[]
  learningPaths      LearningPath[]
  loginHistory       LoginHistory[]
  notifications      Notification[]
  payments           Payment[]
  progress           Progress[]
  refreshTokens      RefreshToken[]
  wallet             RewardWallet?
  sessions           Session[]
  missions           StudentMission[]
  subscription       Subscription?
  transactions       Transaction[]
  school             School?                @relation(fields: [schoolId], references: [id])
  achievements       UserAchievement[]
  earnedBadges       UserBadge[]
  grade              Grade?                 @relation(fields: [gradeId], references: [id])
  enrollments        Enrollment[]
  courseProgress     CourseProgress[]
  classEnrollments   ClassEnrollment[]
  homeroomClasses    SchoolClass[]          @relation("HomeroomTeacher")
  quizAttempts       QuizAttempt[]
  activityAttempts   ActivityAttempt[]
  assignmentsCreated Assignment[]           @relation("AssignmentAuthor")
  submissions        AssignmentSubmission[] @relation("SubmissionStudent")
  graded             AssignmentSubmission[] @relation("SubmissionGrader")
  examsCreated       Exam[]                 @relation("ExamAuthor")
  examAttempts       ExamAttempt[]
  studentQuests      StudentQuest[]
  xpEvents           XpEvent[]
  analyticsEvents    AnalyticsEvent[]
  auditLogs          AuditLog[]

  @@index([schoolId])
  @@index([role])
  @@index([schoolId, role])
  @@index([gradeId])
}

model District {
  id        String   @id @default(cuid())
  name      String
  region    String   @default("")
  createdAt DateTime @default(now())
  schools   School[]
}

model School {
  id            String               @id @default(cuid())
  name          String
  slug          String?              @unique
  // Join code teachers/students use to attach themselves to this school.
  code          String?              @unique
  city          String?
  country       String?
  timezone      String               @default("UTC")
  isActive      Boolean              @default(true)
  districtId    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
  district      District?            @relation(fields: [districtId], references: [id])
  members       User[]
  grades        Grade[]
  classes       SchoolClass[]
  courses       Course[]
  certificates  Certificate[]
  subscriptions SchoolSubscription[]
  auditLogs     AuditLog[]

  @@index([districtId])
}

// A grade level. School-scoped when schoolId is set, otherwise a platform-wide
// level (e.g. "Grade 5") that any school can reuse.
model Grade {
  id        String        @id @default(cuid())
  name      String
  level     Int           @default(0)
  schoolId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  school    School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   SchoolClass[]
  courses   Course[]
  students  User[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// A class/section within a school ("Grade 5 — Sunflower").
model SchoolClass {
  id                String            @id @default(cuid())
  name              String
  schoolId          String
  gradeId           String?
  homeroomTeacherId String?
  academicYear      String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade             Grade?            @relation(fields: [gradeId], references: [id])
  homeroomTeacher   User?             @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students          ClassEnrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([gradeId])
  @@index([homeroomTeacherId])
}

model ClassEnrollment {
  id         String      @id @default(cuid())
  classId    String
  studentId  String
  active     Boolean     @default(true)
  enrolledAt DateTime    @default(now())
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model ChildProfile {
  id        String   @id @default(cuid())
  name      String
  age       Int
  avatar    String   @default("#8B5CF6")
  parentId  String
  createdAt DateTime @default(now())
  parent    User     @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
}

model Subject {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  accent  String
  courses Course[]
}

model Course {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  title                String
  description          String           @default("")
  category             String?
  subCategory          String?
  topic                String?
  ageBand              String?
  gradient             String           @default("from-brand-500 to-brand-800")
  accent               String           @default("#7C3AED")
  isPremium            Boolean          @default(false)
  published            Boolean          @default(false)
  status               CourseStatus     @default(DRAFT)
  subjectId            String?
  teacherId            String?
  language             String?
  subtitleLanguage     String?
  levelId              String?
  duration             String?
  thumbnailUrl         String?
  trailerUrl           String?
  learningPoints       String[]         @default([])
  requirements         String[]         @default([])
  tags                 String[]         @default([])
  objectives           String[]         @default([])
  schoolId             String?
  gradeId              String?
  visibility           CourseVisibility @default(SCHOOL)
  accessType           CourseAccessType @default(FREE)
  sponsorName          String?
  prerequisiteCourseId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  subject              Subject?         @relation(fields: [subjectId], references: [id])
  teacher              User?            @relation("TeacherCourses", fields: [teacherId], references: [id])
  school               School?          @relation(fields: [schoolId], references: [id])
  grade                Grade?           @relation(fields: [gradeId], references: [id])
  prerequisite         Course?          @relation("CoursePrerequisite", fields: [prerequisiteCourseId], references: [id])
  dependents           Course[]         @relation("CoursePrerequisite")
  lessons              Lesson[]
  resources            Resource[]
  sections             Section[]
  quizzes              Quiz[]
  assignments          Assignment[]
  exams                Exam[]
  enrollments          Enrollment[]
  progressRecords      CourseProgress[]
  certificates         Certificate[]
  quests               Quest[]

  @@index([schoolId])
  @@index([gradeId])
  @@index([teacherId])
  @@index([published, visibility])
  @@index([schoolId, gradeId, published])
}

// A student's access to a course. Created on self-enrol or by a teacher/admin.
model Enrollment {
  id         String           @id @default(cuid())
  courseId   String
  studentId  String
  status     EnrollmentStatus @default(ACTIVE)
  grantedBy  String?
  enrolledAt DateTime         @default(now())
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

// Rolled-up per-course progress. Derived from Progress rows; cached here so the
// student/parent/teacher dashboards do not recompute it on every request.
model CourseProgress {
  id               String    @id @default(cuid())
  courseId         String
  studentId        String
  percent          Int       @default(0)
  lessonsCompleted Int       @default(0)
  lessonsTotal     Int       @default(0)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student          User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

model Section {
  id          String       @id @default(cuid())
  title       String
  description String?
  objectives  String[]     @default([])
  order       Int
  courseId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lectures    Lecture[]
  lessons     Lesson[]
  quizzes     Quiz[]
  assignments Assignment[]
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model Lecture {
  id            String   @id @default(cuid())
  title         String
  content       String?
  order         Int      @default(0)
  videoUrl      String?
  videoFileName String?
  quiz          Json?
  sectionId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Lesson {
  id               String       @id @default(cuid())
  title            String
  description      String?
  // Rich text / markdown body for ARTICLE and INTERACTIVE lessons. Media itself
  // is never stored here — only URLs produced by StorageService.
  content          String?
  duration         String       @default("5 min")
  estimatedMinutes Int          @default(5)
  type             LessonType   @default(VIDEO)
  order            Int          @default(0)
  videoUrl         String?
  audioUrl         String?
  imageUrls        String[]     @default([])
  documentUrls     String[]     @default([])
  objectives       String[]     @default([])
  isRequired       Boolean      @default(true)
  xpReward         Int          @default(20)
  coinReward       Int          @default(5)
  courseId         String
  sectionId        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section          Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  progress         Progress[]
  quiz             Quiz?
  resources        Resource[]
  activities       Activity[]
  assignments      Assignment[]

  @@index([courseId, order])
  @@index([sectionId, order])
}

// A single interactive exercise inside a lesson. `config` holds the
// type-specific payload the frontend ActivityRenderer draws; `solution` holds
// the answer key and is NEVER serialised to a student.
model Activity {
  id           String            @id @default(cuid())
  title        String
  instructions String?
  type         ActivityType      @default(MULTIPLE_CHOICE)
  order        Int               @default(0)
  config       Json              @default("{}")
  solution     Json              @default("{}")
  points       Int               @default(10)
  xpReward     Int               @default(15)
  coinReward   Int               @default(5)
  lessonId     String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  lesson       Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts     ActivityAttempt[]

  @@index([lessonId, order])
}

model ActivityAttempt {
  id         String   @id @default(cuid())
  activityId String
  studentId  String
  response   Json     @default("{}")
  score      Int      @default(0)
  maxScore   Int      @default(0)
  correct    Boolean  @default(false)
  attemptNo  Int      @default(1)
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([activityId, studentId])
  @@index([studentId])
}

model Resource {
  id        String       @id @default(cuid())
  name      String
  courseId  String
  kind      ResourceKind @default(other)
  url       String
  sizeBytes Int          @default(0)
  lessonId  String
  createdAt DateTime     @default(now())
  course    Course       @relation(fields: [courseId], references: [id])
  lesson    Lesson       @relation(fields: [lessonId], references: [id])
}

model Quiz {
  id               String         @id @default(cuid())
  title            String
  description      String?
  lessonId         String?        @unique
  courseId         String?
  sectionId        String?
  passingScore     Int            @default(60)
  timeLimitSec     Int?
  maxAttempts      Int            @default(0) // 0 = unlimited
  shuffleQuestions Boolean        @default(false)
  shuffleOptions   Boolean        @default(false)
  xpReward         Int            @default(30)
  coinReward       Int            @default(10)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  lesson           Lesson?        @relation(fields: [lessonId], references: [id])
  course           Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section          Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]

  @@index([courseId])
  @@index([sectionId])
}

model QuizAttempt {
  id          String        @id @default(cuid())
  quizId      String
  studentId   String
  attemptNo   Int           @default(1)
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int           @default(0)
  maxScore    Int           @default(0)
  percent     Int           @default(0)
  passed      Boolean       @default(false)
  answers     Json          @default("{}")
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  expiresAt   DateTime?
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId, attemptNo])
  @@index([studentId])
}

model QuizQuestion {
  id          String       @id @default(cuid())
  prompt      String
  // Legacy single-answer shape, still the fast path for MULTIPLE_CHOICE.
  options     String[]
  correct     Int
  type        QuestionType @default(MULTIPLE_CHOICE)
  order       Int          @default(0)
  points      Int          @default(1)
  explanation String?
  imageUrl    String?
  // Payload for the richer types (matching pairs, ordering sequence,
  // drag-drop targets, accepted short answers). Answer keys live here and are
  // stripped before any student-facing serialisation.
  data        Json?
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

// ---------------------------------------------------------------------------
// Assignments
// ---------------------------------------------------------------------------

model Assignment {
  id              String                 @id @default(cuid())
  title           String
  instructions    String                 @default("")
  dueAt           DateTime?
  points          Int                    @default(100)
  submissionTypes SubmissionType[]       @default([TEXT])
  attachmentUrls  String[]               @default([])
  rubric          Json?
  published       Boolean                @default(false)
  courseId        String
  sectionId       String?
  lessonId        String?
  teacherId       String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section         Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  lesson          Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  teacher         User                   @relation("AssignmentAuthor", fields: [teacherId], references: [id])
  submissions     AssignmentSubmission[]

  @@index([courseId])
  @@index([teacherId])
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  text           String?
  attachmentUrls String[]         @default([])
  status         SubmissionStatus @default(SUBMITTED)
  score          Int?
  feedback       String?
  gradedById     String?
  gradedAt       DateTime?
  submittedAt    DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User             @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy       User?            @relation("SubmissionGrader", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Exams
// ---------------------------------------------------------------------------

model Exam {
  id               String         @id @default(cuid())
  title            String
  description      String?
  courseId         String
  teacherId        String
  timeLimitMin     Int            @default(60)
  passingScore     Int            @default(70)
  maxAttempts      Int            @default(2)
  questionCount    Int? // draw N random questions from the pool
  shuffleQuestions Boolean        @default(true)
  shuffleOptions   Boolean        @default(true)
  isFinal          Boolean        @default(true)
  published        Boolean        @default(false)
  xpReward         Int            @default(150)
  coinReward       Int            @default(50)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher          User           @relation("ExamAuthor", fields: [teacherId], references: [id])
  questions        ExamQuestion[]
  attempts         ExamAttempt[]

  @@index([courseId])
  @@index([teacherId])
}

model ExamQuestion {
  id          String       @id @default(cuid())
  examId      String
  prompt      String
  type        QuestionType @default(MULTIPLE_CHOICE)
  options     String[]     @default([])
  correct     Int          @default(0)
  correctText String?
  data        Json?
  points      Int          @default(1)
  order       Int          @default(0)
  explanation String?
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, order])
}

model ExamAttempt {
  id          String        @id @default(cuid())
  examId      String
  studentId   String
  attemptNo   Int           @default(1)
  status      AttemptStatus @default(IN_PROGRESS)
  // Question ids in the order served, so a resumed attempt is identical and
  // grading only considers the questions this student was actually given.
  questionIds String[]      @default([])
  answers     Json          @default("{}")
  score       Int           @default(0)
  maxScore    Int           @default(0)
  percent     Int           @default(0)
  passed      Boolean       @default(false)
  startedAt   DateTime      @default(now())
  expiresAt   DateTime?
  submittedAt DateTime?
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, attemptNo])
  @@index([studentId])
}

model Progress {
  id        String   @id @default(cuid())
  completed Boolean  @default(false)
  percent   Int      @default(0)
  userId    String
  lessonId  String
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Badge {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  desc     String
  glyph    String
  gradient String
  users    UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Certificate {
  id          String   @id @default(cuid())
  courseName  String
  userId      String
  courseId    String?
  schoolId    String?
  // Human-readable, shareable verification id (KID-XXXXXXXX).
  serial      String?  @unique
  studentName String?
  schoolName  String?
  gradeName   String?
  score       Int?
  issuedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([schoolId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String           @id @default(cuid())
  plan       PlanKey          @default(free)
  status     String           @default("active")
  provider   PaymentProvider?
  externalId String?
  userId     String           @unique
  renewsAt   DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  status      PaymentStatus   @default(pending)
  plan        PlanKey
  amountCents Int
  currency    String          @default("USD")
  externalId  String?         @unique
  userId      String
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  device     String   @default("unknown")
  ip         String   @default("")
  userId     String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id        String   @id @default(cuid())
  success   Boolean
  ip        String   @default("")
  userAgent String   @default("")
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Avatar {
  id          String   @id @default(cuid())
  userId      String   @unique
  body        String   @default("default")
  skinColor   String   @default("#F1C27D")
  hair        String   @default("short")
  face        String   @default("happy")
  clothes     String   @default("school")
  accessories String[] @default([])
  pet         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AvatarItem {
  id        String      @id @default(cuid())
  name      String
  category  String
  rarity    Rarity      @default(common)
  price     Int         @default(0)
  assetUrl  String      @default("")
  inventory Inventory[]
}

model Inventory {
  id          String     @id @default(cuid())
  userId      String
  itemId      String
  equipped    Boolean    @default(false)
  purchasedAt DateTime   @default(now())
  item        AvatarItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Pet {
  id     String @id @default(cuid())
  name   String
  type   String
  rarity Rarity @default(common)
  level  Int    @default(1)
}

model RewardWallet {
  id     String @id @default(cuid())
  userId String @unique
  coins  Int    @default(0)
  gems   Int    @default(0)
  xp     Int    @default(0)
  level  Int    @default(1)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        TxnType
  amount      Int
  description String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String            @id @default(cuid())
  title       String
  description String
  badgeUrl    String            @default("")
  category    String            @default("Learning")
  requirement Int               @default(1)
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  unlockedAt    DateTime?
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Mission {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  rewardXP    Int              @default(0)
  rewardCoins Int              @default(0)
  students    StudentMission[]
}

model StudentMission {
  id          String    @id @default(cuid())
  studentId   String
  missionId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, missionId])
}

model LearningPath {
  id        String @id @default(cuid())
  studentId String
  world     World
  progress  Int    @default(0)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, world])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  message   String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String               @id @default(cuid())
  type      String               @default("dm")
  title     String?
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String       @default("member")
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  type           String       @default("text")
  attachmentUrl  String?
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  reactions      Json         @default("{}")
  readBy         String[]     @default([])
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

