{
  "name": "kidora-api",
  "version": "1.0.0",
  "description": "Kidora Education Platform API \u2014 AI-powered learning ecosystem for children, parents, teachers, schools, and districts.",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\"",
    "db:backfill": "ts-node prisma/backfill-lms.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:seed:lms": "ts-node prisma/seed-lms.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@paypal/checkout-server-sdk": "1.0.3",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "4.67.3",
    "otplib": "12.0.1",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "passport-oauth2": "1.8.0",
    "pg": "^8.22.0",
    "prisma": "^6.19.3",
    "qrcode": "1.5.4",
    "redis": "4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.0",
    "stripe": "16.12.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "5.0.2",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "20.16.10",
    "@types/nodemailer": "6.4.16",
    "@types/passport-jwt": "4.0.1",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "jest": "^29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.6.2"
  }
