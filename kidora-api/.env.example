# ---------------------------------------------------------------------------
# Kidora API — copy to .env and fill in.  Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated allow-list. Leave unset to reflect the requesting origin.
CORS_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kidora?schema=public

# --- Redis ----------------------------------------------------------------
# Used for the token blacklist, OTP codes, leaderboards and the Socket.IO
# adapter. The API still runs without it; SMS codes fall back to per-instance
# in-memory storage.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
MFA_ISSUER=Kidora

# --- Twilio (SMS sign-in, phone verification, SMS MFA) --------------------
# Either naming convention works — use whichever your .env already has.
# Console spelling:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# ...or the short spelling:
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# A Messaging Service is used instead of a from-number when set:
# TWILIO_MESSAGING_SERVICE_SID=

# Local numbers typed without a country code are normalised against this
# (e.g. "0912345678" -> "+251912345678"). Leave unset to require E.164.
SMS_DEFAULT_COUNTRY_CODE=+251

# With no Twilio credentials the API logs the SMS instead of sending it, and
# outside production returns the code as `devCode` so the flow is testable.
# Set this to fail loudly instead of falling back.
SMS_STRICT=false

# --- Mail (MailHog on :1025 in docker compose) ----------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kidora <hello@kidora.com>

# --- OAuth (each strategy self-disables when its client id is absent) ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Storage --------------------------------------------------------------
STORAGE_DIR=./uploads
STORAGE_PUBLIC_BASE=http://localhost:4000/uploads

# --- Payments -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI -------------------------------------------------------------------
AI_API_KEY=

# --- AI service (apps/ai-service) -----------------------------------------
# Internal URL; the AI service is never exposed publicly.
AI_SERVICE_URL=http://ai-service:8000
# Shared secret proving a request came from this API. Must match the value in
# apps/ai-service/.env. Required in production.
AI_SERVICE_TOKEN=
# Provider config lives with the AI service; these are passed through compose.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
