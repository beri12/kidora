# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kidora?schema=public"

# --- Cache / realtime -----------------------------------------------------
# One Redis for the cache, the socket.io adapter and the rate limits.
# Use rediss:// for a managed provider that requires TLS; credentials in the
# URL are picked up automatically.
REDIS_URL="redis://localhost:6379"
# Only needed if you pass the parts separately instead of a URL.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# Seconds. Access tokens are short-lived; a refresh re-reads the account, so
# a role change or a disabled account takes effect within this window.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Shown in the user's authenticator app next to their code.
MFA_ISSUER=Kidora

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Where the web app runs. Social login redirects back here after the
# provider round-trip, so it must be right in every deployed environment.
WEB_URL=http://localhost:3000
# Comma-separated allow-list. Leave unset to reflect the request origin.
# CORS_ORIGIN="http://localhost:3000"

# --- Phone sign-in (Twilio) ----------------------------------------------
# The one-time code is only ever delivered by SMS to the number the person
# typed. It is never returned to the browser.
#
# With none of these set in development, the SMS text (code included) is
# printed in the API log instead, so the flow can be tried offline. In
# production an unconfigured Twilio makes phone sign-in answer 503.
#
# TRIAL ACCOUNTS: Twilio trials only text numbers you have added to the
# verified list (twilio.com/console/phone-numbers/verified) and refuse every
# other one with error 21608. The person sees "We couldn't text your code",
# and the log names the error and its fix. Upgrade the account to text anyone.
#
# Both naming conventions are accepted, whichever your .env already uses:
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER
#   TWILIO_SID         / TWILIO_TOKEN      / TWILIO_FROM
# TWILIO_SID=
# TWILIO_TOKEN=
# The sender, in order of preference. A Messaging Service is what
# international OTP traffic wants...
# TWILIO_MESSAGING_SERVICE_SID=
# ...or an alphanumeric sender, so the text arrives from "KIDORA" rather than
# a number (max 11 characters; not accepted in every country, e.g. US/Canada)...
# TWILIO_SENDER_ID=KIDORA
# ...or a purchased number.
# TWILIO_FROM=
#
# The text reads:
#   Kidora: 482913 is your verification code. It expires in 5 minutes.
#   Never share this code — Kidora will never ask for it.
#
#   @app.kidora.com #482913
# The last line lets Chrome on Android fill the code in with one tap (WebOTP).
# It is added automatically when WEB_URL is https; override the domain here.
# SMS_OTP_DOMAIN=app.kidora.com

# --- Email verification ---------------------------------------------------
# Email + password sign-up emails a 6-digit code through the SMTP settings
# above; no session is issued until it comes back. In development, if the
# SMTP server is unreachable, the code is printed in the API log instead.
#
# For the automated e2e suites ONLY: returns codes in API responses (as
# `devCode`) when no SMS/mail provider is reachable. Refused in production.
# Never enable this for real users.
# AUTH_TEST_EXPOSE_OTP=true

# --- Social login ---------------------------------------------------------
# Signs the OAuth `state` (login-CSRF protection). Defaults to JWT_ACCESS_SECRET.
# OAUTH_STATE_SECRET=
#
# Each provider self-disables until its *_CLIENT_ID is set; GET /api/auth/providers
# reports which are live, and the web app only shows those buttons. A provider
# with no client id answers 501 saying which variable to set.
#
# The callback URL is worked out from API_URL (or PORT) and printed at startup
# under "Sign-in:". That printed value is the one sent to the provider, so
# register it with them EXACTLY as shown — a mismatch is what produces
# `redirect_uri_mismatch`, which never says what is wrong.
#
# Google: console.cloud.google.com > APIs & Services > Credentials >
# OAuth client ID (type: Web application) > Authorised redirect URIs.
#
# Set the *_CALLBACK_URL variables only to override the derived value.
# API_URL=https://api.example.com/api
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback
# FACEBOOK_API_VERSION=v19.0
# TikTok calls this the "client key"; set it here and the strategy sends it
# under the name TikTok expects.
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_CALLBACK_URL=http://localhost:4000/api/auth/tiktok/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# --- Email ----------------------------------------------------------------
# Sends are best-effort: a failure is logged, never fatal. docker compose
# brings up MailHog on 1025 with a web UI at :8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Kidora <no-reply@kidora.app>"

# --- File uploads ---------------------------------------------------------
# 'local' writes to STORAGE_DIR and serves from STORAGE_PUBLIC_BASE.
# 's3' uploads to S3/R2/Spaces (also: npm i @aws-sdk/client-s3).
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# Must be an absolute URL — it is returned to the browser as the file's src.
STORAGE_PUBLIC_BASE=http://localhost:4000/uploads
# Max upload size in bytes (default 500MB). Images, documents and subtitles
# have their own smaller ceilings in src/uploads/upload-policy.ts.
UPLOAD_MAX_BYTES=524288000

# Only needed when STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# --- Payments -------------------------------------------------------------
# STRIPE_SECRET_KEY=
# The webhook needs the raw body (rawBody: true in main.ts). In dev:
# stripe listen --forward-to localhost:4000/api/payments/stripe/webhook
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# --- AI tutor -------------------------------------------------------------
# Unset, the tutor answers with built-in heuristics rather than failing.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=

# --- Brought in from the email/SMS branch ---------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+251
SMS_STRICT=false
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_SIGNED_READ_TTL_SEC=21600
VIDEO_MAX_SIZE_MB=1024
VIDEO_ALLOWED_TYPES=video/mp4,video/quicktime,video/webm
VIDEO_UPLOAD_TTL_SEC=21600
VIDEO_COMPLETION_PERCENT=90
API_PUBLIC_BASE=http://localhost:4000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
