# ---------------------------------------------------------------------------
# Kidora API — environment
#
# The school LMS work added NO new REQUIRED variables. Everything new below is
# optional and defaulted. Copy this file to .env for local development; in
# production keep using whatever the existing deployment already sets.
# ---------------------------------------------------------------------------

# --- required (unchanged) ---
DATABASE_URL=postgresql://kidora:kidora@localhost:5432/kidora?schema=public
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# --- existing, optional ---
PORT=4000
NODE_ENV=development
# Comma-separated allow-list. Unset reflects the request origin.
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_HOST=localhost
SMTP_PORT=1025

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- storage (already existed; now the single path for LMS uploads) ---
# 'local' writes into STORAGE_DIR and serves it from /uploads; 's3' needs the
# S3_* vars below and `npm i @aws-sdk/client-s3`.
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
STORAGE_PUBLIC_BASE=http://localhost:4000/uploads
UPLOAD_MAX_BYTES=524288000

# S3 / R2 / Spaces (only when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# --- migrations ---
# Only needed by `prisma migrate dev`; `prisma migrate deploy` does not use it.
SHADOW_DATABASE_URL=
