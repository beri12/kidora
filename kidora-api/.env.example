# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kidora?schema=public"

# --- Cache / realtime -----------------------------------------------------
# One Redis for the cache, the socket.io adapter and the rate limits.
# Use rediss:// for a managed provider that requires TLS; credentials in the
# URL are picked up automatically.
REDIS_URL="redis://localhost:6379"
# Only needed if you pass the parts separately instead of a URL.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# Seconds. Access tokens are short-lived; a refresh re-reads the account, so
# a role change or a disabled account takes effect within this window.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Shown in the user's authenticator app next to their code.
MFA_ISSUER=Kidora

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Where the web app runs. Social login redirects back here after the
# provider round-trip, so it must be right in every deployed environment.
WEB_URL=http://localhost:3000
# Comma-separated allow-list. Leave unset to reflect the request origin.
# CORS_ORIGIN="http://localhost:3000"

# --- Phone sign-in (Twilio) ----------------------------------------------
# With none of these set, the code is logged and returned in the response as
# `devCode`, so the flow is testable offline. Never in production.
# TWILIO_SID=
# TWILIO_TOKEN=
# A purchased number...
# TWILIO_FROM=
# ...or a Messaging Service, which is what international OTP traffic wants.
# TWILIO_MESSAGING_SERVICE_SID=

# --- Social login ---------------------------------------------------------
# Each provider self-disables until its *_CLIENT_ID is set; GET /api/auth/providers
# reports which are live, and the web app only shows those buttons.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback
# FACEBOOK_API_VERSION=v19.0
# TikTok calls this the "client key"; set it here and the strategy sends it
# under the name TikTok expects.
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_CALLBACK_URL=http://localhost:4000/api/auth/tiktok/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# --- Email ----------------------------------------------------------------
# Sends are best-effort: a failure is logged, never fatal. docker compose
# brings up MailHog on 1025 with a web UI at :8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Kidora <no-reply@kidora.app>"

# --- File uploads ---------------------------------------------------------
# 'local' writes to STORAGE_DIR and serves from STORAGE_PUBLIC_BASE.
# 's3' uploads to S3/R2/Spaces (also: npm i @aws-sdk/client-s3).
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# Must be an absolute URL — it is returned to the browser as the file's src.
STORAGE_PUBLIC_BASE=http://localhost:4000/uploads
# Max upload size in bytes (default 500MB). Images, documents and subtitles
# have their own smaller ceilings in src/uploads/upload-policy.ts.
UPLOAD_MAX_BYTES=524288000

# Only needed when STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# --- Payments -------------------------------------------------------------
# STRIPE_SECRET_KEY=
# The webhook needs the raw body (rawBody: true in main.ts). In dev:
# stripe listen --forward-to localhost:4000/api/payments/stripe/webhook
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# --- AI tutor -------------------------------------------------------------
# Unset, the tutor answers with built-in heuristics rather than failing.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=
